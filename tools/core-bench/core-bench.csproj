<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Times Launcher.Core's config, scan and query paths on the runtime the export ships: self-contained
    .NET 8, optimised (ExportRelease). Not part of the solution. See docs/perf/m2-core.md.
      dotnet publish tools/core-bench -c ExportRelease -o artifacts/core-bench
      artifacts/core-bench/core-bench.exe <absolute work folder>
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Configurations>Debug;ExportDebug;ExportRelease</Configurations>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- The runtime Godot 4.7.2's export bundles. -->
    <RuntimeFrameworkVersion>8.0.31</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Launcher.Core\Launcher.Core.csproj" />
    <Compile Include="..\..\tests\Launcher.Core.Tests\Benchmarks\FakeRomTree.cs" Link="FakeRomTree.cs" />
  </ItemGroup>

</Project>
