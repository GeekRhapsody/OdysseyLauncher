<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A stand-in emulator for the launch tests: logs how it was started, optionally sleeps or starts a copy of
    itself (a stub launcher), and exits with a chosen code. See Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Runs on the newest installed runtime, like the test project. -->
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <Configurations>Debug;ExportDebug;ExportRelease</Configurations>
    <RootNamespace>Launcher.FakeEmulator</RootNamespace>
  </PropertyGroup>

</Project>
