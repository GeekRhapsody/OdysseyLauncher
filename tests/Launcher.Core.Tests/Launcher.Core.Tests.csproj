<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <!--
      Run on the newest installed runtime when .NET 8 isn't installed, the same way Godot's editor
      hosts the game code (GodotPlugins uses rollForward LatestMajor).
    -->
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <Configurations>Debug;ExportDebug;ExportRelease</Configurations>
    <!-- LibraryImport (CommandLineToArgvW in WindowsCommandLineTests). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Launcher.Core\Launcher.Core.csproj" />
    <!-- Built first, but not referenced: the launch tests run it as a process (FakeEmulator.OutputDir). -->
    <ProjectReference Include="..\FakeEmulator\FakeEmulator.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded provider responses for the scraping tests (no test touches the network). -->
    <None Include="Scraping\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="FakeEmulatorDir" Value="$(MSBuildThisFileDirectory)..\FakeEmulator\bin\$(Configuration)\net8.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

</Project>
