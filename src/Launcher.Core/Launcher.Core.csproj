<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Follows the TFM Godot generates (4.7: net8.0). Bump every project together. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Configurations>Debug;ExportDebug;ExportRelease</Configurations>
    <!-- LibraryImport's generated marshalling, and the pointer-based Win32 structs in Platform/Windows. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Launcher.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stable resource names, independent of MSBuild's folder-name mangling: defaults/<file>, migrations/<db>/<file>. -->
    <EmbeddedResource Include="Defaults\*.toml" LogicalName="defaults/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Data\Migrations\Library\*.sql" LogicalName="migrations/library/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Data\Migrations\User\*.sql" LogicalName="migrations/user/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

</Project>
